<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Learn Cued Speech – Cued American English Phoneme Cues</title>
  <link rel="stylesheet" href="assets/styles.css" />
</head>

<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap">
      <h1 class="site-title">Learn Cued Speech (Cued American English)</h1>
      <nav aria-label="Primary">
        <a href="#about">About</a>
        <a href="#consonants">Consonants</a>
        <a href="#vowels">Vowels</a>
        <a href="#resources">Resources</a>
      </nav>
    </div>
  </header>

  <main id="main" class="wrap" tabindex="-1">
    <section id="about" aria-labelledby="about-h">
      <h2 id="about-h">About</h2>
      <p>
        Select a sound to see the corresponding cue components (handshape and/or placement),
        plus an optional audio sample.
      </p>
    </section>

    <section id="consonants" aria-labelledby="c-h">
      <h2 id="c-h">Consonants</h2>
      <div id="consonantGrid" class="cue-grid" role="group" aria-labelledby="c-h"></div>
    </section>

    <section id="vowels" aria-labelledby="v-h">
      <h2 id="v-h">Vowels</h2>
      <div id="vowelGrid" class="cue-grid" role="group" aria-labelledby="v-h"></div>
    </section>

    <section id="resources" aria-labelledby="r-h">
      <h2 id="r-h">Resources</h2>
      <p>
        Link users to official charts rather than re-hosting restricted PDFs.
        Include licensing and attributions for any third-party assets.
      </p>
    </section>
  </main>

  <!-- Accessible modal using <dialog> -->
  <dialog id="cueDialog" aria-labelledby="dlgTitle" aria-describedby="dlgDesc">
    <form method="dialog" class="dialog-card">
      <div class="dialog-head">
        <h2 id="dlgTitle" class="dialog-title">Cue details</h2>
        <button class="icon-btn" value="close" aria-label="Close cue details" autofocus>
          ✕
        </button>
      </div>

      <div class="dialog-body">
        <figure class="cue-figure">
          <img id="dlgImg"
               alt=""
               decoding="async"
               width="420" height="320" />
          <figcaption id="dlgDesc"></figcaption>
        </figure>

        <div class="dialog-meta" id="dlgMeta"></div>

        <div class="audio-row" id="dlgAudioRow" hidden>
          <audio id="dlgAudio" controls preload="none"></audio>
        </div>
      </div>
    </form>
  </dialog>

  <script type="module" src="assets/app.js"></script>
</body>
</html>
